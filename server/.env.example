# i-Droid server configuration — copy to your shell, a Render environment, or
# pass to Docker with --env-file.
#
# The server reads real environment variables; it does not load this file
# itself. Nothing here is a secret until you fill it in.
#
# Run it locally on port 8090, not 8080: 8080 is often already taken by another
# dev server (PHP, Node), and the app would then talk to that instead.
#   uvicorn --factory app.main:create_app --host 0.0.0.0 --port 8090
# The Docker image still listens on 8080 internally; publish it as 8090
# (-p 8090:8080). On Render the platform sets PORT itself.

# --- access ---------------------------------------------------------------
# "key:user" pairs, comma separated. Each user gets their own libraries.
# Users type their key into Settings in the app.
IDROID_API_KEYS=change-me-user-key:alice
# Admin key: may install board cores and change board URLs.
IDROID_ADMIN_KEYS=change-me-admin-key:admin
# Classroom mode: compile and browse without a key. The assistant and library
# installs stay key-only, because both change the server or cost money.
IDROID_ALLOW_ANONYMOUS=false

# --- online assistant -----------------------------------------------------
# All three must be set or the assistant reports enabled=false and the app
# hides it. The provider key never leaves the server.
#
# DeepSeek (prepaid):
IDROID_LLM_BASE_URL=https://api.deepseek.com
IDROID_LLM_API_KEY=sk-your-deepseek-key
IDROID_LLM_MODEL=deepseek-flash
#
# Gemini free tier:
# IDROID_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# IDROID_LLM_MODEL=gemini-3.8-flash
#
# A local Ollama (free, offline, no key needed — but the value must be non-empty):
# IDROID_LLM_BASE_URL=http://127.0.0.1:11434/v1
# IDROID_LLM_API_KEY=ollama
# IDROID_LLM_MODEL=qwen2.5-coder:7b
#
# Every answer costs a provider call, so this bucket is small and counted per
# API key. Set IDROID_ASSISTANT_ENABLED=false to switch the feature off while
# keeping the keys in place.
IDROID_ASSISTANT_ENABLED=true
IDROID_ASSISTANT_PER_MINUTE=6
# The app hides the API key behind an "Advanced" section, so students usually
# have no key. Turning this on lets them use the assistant, which means anyone
# who installs the app can spend the provider balance — bounded by the limit
# above and by treating each anonymous IP as one caller. Leave false to keep the
# assistant key-only.
IDROID_ASSISTANT_ALLOW_ANONYMOUS=true

# --- assistant access keys ------------------------------------------------
# The app's dialog asks for a key; "Request key" mints one here and emails it to
# IDROID_KEY_EMAIL. Only a hash is stored, and keys expire.
IDROID_KEY_EMAIL=ibrahcombo360@gmail.com
# Real delivery needs SMTP. Without it the key is printed in the server log,
# which is fine for testing but useless in production.
IDROID_SMTP_HOST=smtp.gmail.com
IDROID_SMTP_PORT=587
IDROID_SMTP_USER=ibrahcombo360@gmail.com
# Gmail needs an App Password (2-Step Verification on), never the account
# password: https://myaccount.google.com/apppasswords
IDROID_SMTP_PASSWORD=
IDROID_SMTP_FROM=
# Words that work without requesting a key, e.g. "class-a:teacher,staff:x"
IDROID_ASSISTANT_WORDS=
IDROID_ASSISTANT_KEY_DAYS=30
# Seconds one IP must wait between key requests; stops the inbox being spammed.
IDROID_ASSISTANT_KEY_COOLDOWN=600
# Hard ceiling on answers per day across everyone: the real cost guard.
IDROID_ASSISTANT_DAILY_CAP=300

# --- limits ---------------------------------------------------------------
IDROID_COMPILES_PER_MINUTE=10
IDROID_REQUESTS_PER_MINUTE=120
IDROID_MAX_CONCURRENT_COMPILES=1
IDROID_COMPILE_TIMEOUT=300
IDROID_INSTALL_TIMEOUT=600

# --- paths (the Docker image sets these; only change for a bare-metal run) --
# IDROID_DATA_DIR=/data
# IDROID_BUILTIN_EXAMPLES=/opt/arduino-examples/examples
# IDROID_DEFAULT_BOARD_URLS=https://espressif.github.io/arduino-esp32/package_esp32_index.json
